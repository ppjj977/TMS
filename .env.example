# PostgreSQL connection string used by Prisma.
# For the bundled docker-compose database use:
DATABASE_URL="postgresql://tms:tms@localhost:5432/tms?schema=public"

# Secret used to sign session cookies. Set a long random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Email (optional) -------------------------------------------------------
# If these are set, notifications are sent via SMTP. If unset, notifications
# are recorded to the NotificationLog table and logged to the console instead.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="••••••"
# SMTP_FROM="TMS <ops@yourcourier.example>"

# --- Postcode lookup --------------------------------------------------------
# Uses the free postcodes.io API by default (no key required). Override the
# base URL only if you proxy it or self-host.
# POSTCODES_API_BASE="https://api.postcodes.io"
