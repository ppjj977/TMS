// Transparent Management System (TMS)
// Same-day, multi-drop transport operations.
//
// Core flow:
//   Customer -> Contact -> books a Job (booking) with one or more Stops (drops)
//   -> Job is allocated to a Driver + Vehicle -> progressed through statuses.
//   Pricing is derived from RateCards (customer revenue + driver cost).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum VehicleType {
  BIKE
  CAR
  SMALL_VAN
  SWB_VAN // short wheel base
  LWB_VAN // long wheel base
  LUTON
  SEVEN_FIVE_TONNE
  EIGHTEEN_TONNE
  ARTIC
}

enum AccountStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OFF_ROAD
}

enum JobStatus {
  BOOKED // created, not yet allocated
  ALLOCATED // assigned to a driver/vehicle
  ON_ROUTE // driver is working the job
  COMPLETED // all stops done
  CANCELLED
  INVOICED
}

enum StopType {
  COLLECTION
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
}

// Day classification used for rate-card matching.
enum DayType {
  ANY
  WEEKDAY
  SATURDAY
  SUNDAY
  BANK_HOLIDAY
}

// Time-of-day classification used for rate-card matching.
enum TimeBand {
  ANY
  DAYTIME // standard working hours
  OUT_OF_HOURS // evenings / nights / early mornings
}

// Whether a rate card sets customer revenue or driver cost.
enum RateCardKind {
  CUSTOMER
  DRIVER
}

// The quantity a rate band tiers on.
enum RateBandType {
  DISTANCE // miles
  DROP // number of delivery drops
  PIECE // number of pieces
}

enum Role {
  ADMIN
  OPERATOR
  DRIVER
  CUSTOMER
}

enum ServiceLevel {
  SAMEDAY_DIRECT // dedicated, straight there
  SAMEDAY_STANDARD // same-day multi-drop
  TIMED // delivered within a booked window
  OVERNIGHT // next working day
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// A recorded event against a job (status change, allocation, POD, etc.).
enum JobEventType {
  CREATED
  ALLOCATED
  UNALLOCATED
  STATUS_CHANGE
  STOP_UPDATE
  POD_CAPTURED
  INVOICED
  NOTE
}

enum NotificationStatus {
  SENT // handed to SMTP
  LOGGED // no SMTP configured; recorded only
  FAILED
}

enum InvoiceSchedule {
  ON_COMPLETION
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum AccountType {
  PREPAY
  CREDIT
}

enum QuoteStatus {
  DRAFT
  SENT
  CONVERTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Customers & contacts
// ---------------------------------------------------------------------------

model Customer {
  id           String        @id @default(cuid())
  accountCode  String        @unique
  name         String
  status       AccountStatus @default(ACTIVE)
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  paymentTerms Int           @default(30) // days
  notes        String?

  // Account configuration
  invoiceSchedule InvoiceSchedule @default(ON_COMPLETION)
  accountType     AccountType     @default(CREDIT)
  slaGroup        String?
  category        String?

  contacts       Contact[]
  jobs           Job[]
  rateCards      RateCard[]
  users          User[]
  invoices       Invoice[]
  savedAddresses SavedAddress[]
  quotes         Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A reusable address in a customer's address book (pickup/delivery picker).
model SavedAddress {
  id           String  @id @default(cuid())
  customerId   String
  label        String // e.g. "Manchester DC"
  name         String? // site / company name
  addressLine1 String
  addressLine2 String?
  city         String?
  postcode     String
  contactName  String?
  contactPhone String?
  latitude     Float?
  longitude    Float?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Contact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Fleet & drivers
// ---------------------------------------------------------------------------

model Vehicle {
  id           String        @id @default(cuid())
  registration String        @unique
  type         VehicleType
  make         String?
  model        String?
  status       VehicleStatus @default(ACTIVE)
  notes        String?

  jobs    Job[]
  drivers Driver[] // drivers whose default vehicle this is

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id               String       @id @default(cuid())
  name             String
  email            String?
  phone            String?
  status           DriverStatus @default(ACTIVE)
  licenceNumber    String?
  defaultVehicleId String?
  notes            String?

  defaultVehicle Vehicle?   @relation(fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  jobs           Job[]
  rateCards      RateCard[]
  user           User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultVehicleId])
}

// ---------------------------------------------------------------------------
// Jobs (bookings) & stops (drops)
// ---------------------------------------------------------------------------

model Job {
  id        String    @id @default(cuid())
  reference String    @unique // human-friendly e.g. JOB-2026-0001
  status    JobStatus @default(BOOKED)

  customerId String
  contactId  String?

  // Service requirements
  vehicleType  VehicleType
  serviceLevel ServiceLevel @default(SAMEDAY_STANDARD)
  serviceDate  DateTime // the day the work is performed
  bookedAt     DateTime     @default(now())

  // Allocation
  driverId  String?
  vehicleId String?

  // Consignment metrics
  pieces  Int   @default(1)
  weightKg Float @default(0)

  // Distance & timing used by the pricing engine
  distanceMiles Float @default(0)
  estimatedMins Int   @default(0)

  // Day/time classification captured at booking (drives rate selection)
  dayType  DayType  @default(WEEKDAY)
  timeBand TimeBand @default(DAYTIME)

  // Cached pricing (recomputed whenever the job changes materially)
  customerCharge Float @default(0) // revenue
  driverCost     Float @default(0) // cost to pay the driver
  customerRateCardId String?
  driverRateCardId   String?

  reference_notes String? // operator notes
  customerRef     String? // customer's own PO / reference

  // Invoicing
  invoiceId String?

  customer Customer   @relation(fields: [customerId], references: [id])
  contact  Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  driver   Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  invoice  Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  stops    Stop[]
  events   JobEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([serviceDate])
  @@index([invoiceId])
}

model Stop {
  id       String     @id @default(cuid())
  jobId    String
  sequence Int // order within the run, 1-based
  type     StopType
  status   StopStatus @default(PENDING)

  name         String? // site / company name
  addressLine1 String
  addressLine2 String?
  city         String?
  postcode     String

  contactName  String?
  contactPhone String?

  // Geocode (from postcode lookup) used for distance estimation & mapping.
  latitude  Float?
  longitude Float?

  windowFrom DateTime? // earliest
  windowTo   DateTime? // latest

  completedAt  DateTime?
  podName      String? // proof of delivery: who signed
  podSignature String? // base64 PNG data URL of captured signature
  podPhoto     String? // base64 data URL / URL of a delivery photo
  podNotes     String?
  notes        String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Rate cards (pricing engine)
// ---------------------------------------------------------------------------
//
// A rate card can target a specific customer or driver (or be a default when
// both are null). It can be scoped to a vehicle type, a day type and a time
// band. The pricing engine selects the most specific matching active card.

model RateCard {
  id   String       @id @default(cuid())
  kind RateCardKind
  name String

  customerId String? // when kind = CUSTOMER and not a global default
  driverId   String? // when kind = DRIVER and not a global default

  vehicleType VehicleType? // null = applies to any vehicle type
  dayType     DayType      @default(ANY)
  timeBand    TimeBand     @default(ANY)

  // Simple model (fallback / "single rate over the distance"): £ per mile.
  ratePerMile   Float
  minimumCharge Float @default(0)

  // Banded model: when DISTANCE bands exist they replace ratePerMile; DROP and
  // PIECE bands add per-drop / per-piece charges. See src/lib/pricing.ts.
  bands RateBand[]

  // Extras
  waitingPerHour Float @default(0) // informational; applied to recorded wait
  retailPct      Float @default(0) // uplift applied to the computed charge

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = open-ended

  active Boolean @default(true)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([customerId])
  @@index([driverId])
}

// A pricing tier within a rate card: for quantities in [minValue, maxValue],
// charge `rate` per unit (per mile / per drop / per piece).
model RateBand {
  id         String       @id @default(cuid())
  rateCardId String
  type       RateBandType
  minValue   Float
  maxValue   Float
  rate       Float

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
}

// ---------------------------------------------------------------------------
// Users & authentication
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role    @default(OPERATOR)
  active       Boolean @default(true)

  // Optional links that scope what a user can see.
  driverId   String? @unique // DRIVER users map to a driver record
  customerId String? // CUSTOMER users belong to a customer account

  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Job event audit trail
// ---------------------------------------------------------------------------

model JobEvent {
  id      String       @id @default(cuid())
  jobId   String
  type    JobEventType
  message String
  actor   String? // who/what triggered it (user name / "system" / driver)

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Invoicing
// ---------------------------------------------------------------------------

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique // e.g. INV-2026-0001
  customerId String
  status     InvoiceStatus @default(DRAFT)

  issueDate DateTime @default(now())
  dueDate   DateTime
  subtotal  Float    @default(0)
  vat       Float    @default(0)
  total     Float    @default(0)
  notes     String?

  customer Customer      @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]
  jobs     Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  jobId       String?
  description String
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Notification log (email + future channels)
// ---------------------------------------------------------------------------

model NotificationLog {
  id        String             @id @default(cuid())
  channel   String             @default("email")
  to        String
  subject   String
  body      String
  status    NotificationStatus
  error     String?
  jobId     String?
  createdAt DateTime           @default(now())

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Company settings (singleton) — your own billing identity, used on invoices.
// ---------------------------------------------------------------------------

model CompanySetting {
  id           String  @id @default(cuid())
  name         String  @default("Your Company Ltd")
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  email        String?
  phone        String?
  vatNumber    String?
  vatRate      Float   @default(20) // %
  companyReg   String?
  bankName     String?
  sortCode     String?
  accountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Quotes
// ---------------------------------------------------------------------------

model Quote {
  id           String      @id @default(cuid())
  reference    String      @unique // QUO-2026-0001
  customerId   String?
  customerName String? // for ad-hoc quotes without an account
  vehicleType  VehicleType
  serviceLevel ServiceLevel @default(SAMEDAY_STANDARD)

  collectionPostcode String?
  deliveryPostcode   String?
  distanceMiles      Float  @default(0)
  drops              Int    @default(1)
  pieces             Int    @default(1)

  amount       Float       @default(0)
  rateCardName String?
  status       QuoteStatus @default(DRAFT)
  notes        String?

  convertedJobId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Control Room saved views ("traffic screens").
// ---------------------------------------------------------------------------

model TrafficScreen {
  id            String         @id @default(cuid())
  name          String
  orderIndex    Int            @default(0)
  statuses      JobStatus[] // jobs in any of these statuses are shown
  serviceLevels ServiceLevel[] // empty = any
  vehicleType   VehicleType? // null = any

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
